@model Pedidos.Web.ViewModels.RastreoViewModel
@{
    ViewBag.Title = "Consultar rastreo";
}

<div class="encabezado">
    <div>
        <span class="sobretitulo">Seguimiento</span>
        <h1>Consultar rastreo</h1>
        <p class="subtitulo">Escriba el número de rastreo o el identificador público de la orden.</p>
    </div>
</div>

<div class="tarjeta mb-4">
    @using (Html.BeginForm("Rastreo", "Ordenes", FormMethod.Get))
    {
        <label for="criterio" class="form-label">Número de rastreo o identificador de la orden</label>
        <div class="d-flex flex-wrap gap-2">
            <input type="text" id="criterio" name="criterio" class="form-control input-mono flex-grow-1" style="min-width: 240px; flex-basis: 320px;" maxlength="100" value="@Model.Criterio" placeholder="EJ. CR2024ABC123" />
            <button type="submit" class="btn btn-primary">Consultar</button>
        </div>
        @Html.ValidationMessage("criterio", new { @class = "text-danger d-block mt-2" })
    }
</div>

@if (Model.Encontrada)
{
    <div class="etiqueta" aria-live="polite">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
            <div>
                <span class="rotulo">Número de rastreo</span>
                @if (Model.NumeroRastreo != null)
                {
                    <span class="valor-grande">@Model.NumeroRastreo</span>
                }
                else
                {
                    <span class="valor-grande text-muted">Aún no disponible</span>
                }
            </div>
            <span class="pill pill-@Model.Estado">@(Model.Estado == "EnPreparacion" ? "En preparación" : Model.Estado)</span>
        </div>

        <dl class="row ficha mb-3">
            <dt class="col-sm-3">Identificador</dt>
            <dd class="col-sm-9"><span class="codigo">@Model.Id</span></dd>
            <dt class="col-sm-3">Creada (UTC)</dt>
            <dd class="col-sm-9">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>
            @if (Model.FechaEnvio.HasValue)
            {
                <dt class="col-sm-3">Enviada (UTC)</dt>
                <dd class="col-sm-9">@Model.FechaEnvio.Value.ToString("dd/MM/yyyy HH:mm")</dd>
            }
            @if (Model.FechaEntrega.HasValue)
            {
                <dt class="col-sm-3">Entregada (UTC)</dt>
                <dd class="col-sm-9">@Model.FechaEntrega.Value.ToString("dd/MM/yyyy HH:mm")</dd>
            }
        </dl>

        @Html.ActionLink("Ver detalle de la orden", "Detalle", new { id = Model.Id }, new { @class = "btn btn-outline-primary btn-sm" })
    </div>
}