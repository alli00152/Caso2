@model List<Pedidos.Web.ViewModels.OrdenListadoItemViewModel>
@{
    ViewBag.Title = "Órdenes";
}

<h2>Órdenes</h2>
<p>@Html.ActionLink("Nueva orden", "Crear", null, new { @class = "btn btn-primary" })</p>

@if (Model.Count == 0)
{
    <p class="text-muted">No hay órdenes para mostrar.</p>
}
else
{
    <table class="table table-striped">
        <caption class="visually-hidden">Listado de órdenes</caption>
        <thead>
            <tr>
                <th scope="col">Cliente</th>
                <th scope="col">Estado</th>
                <th scope="col">Rastreo</th>
                <th scope="col">Creada (UTC)</th>
                <th scope="col"><span class="visually-hidden">Acciones</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ClienteNombre</td>
                    <td>@item.Estado</td>
                    <td>@(item.NumeroRastreo ?? "—")</td>
                    <td>@item.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@Html.ActionLink("Ver", "Detalle", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-primary" })</td>
                </tr>
            }
        </tbody>
    </table>
}
